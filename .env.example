# fake = heuristic composer, zero API calls (default)
# live = real LLM + replies returned to SalesIQ
# dry_run / shadow = compose (real only if BOT_ALLOW_LIVE=1) but return no visitor-visible reply
BOT_MODE=fake
# Must be 1 before any real paid LLM call. This is the spend switch.
BOT_ALLOW_LIVE=0

BOT_LLM_MODEL=gpt-5-nano
# Vision model for reference-image turns (multimodal). Separate from text compose.
BOT_VISION_MODEL=gpt-4o-mini
BOT_LLM_BASE_URL=https://api.openai.com/v1
BOT_LLM_API_KEY=
BOT_TIMEOUT_S=6
# Max inbound reference image size in bytes (default 8MB).
BOT_ATTACHMENT_MAX_BYTES=8388608
# Optional Vercel Blob token. When empty, images save under BOT_DATA_DIR/uploads.
BLOB_READ_WRITE_TOKEN=
# Hard cap on real OpenAI calls per server process (0 = unlimited).
# Use 20-50 for a first live test; restart the server to reset.
BOT_MAX_LLM_CALLS=0
BOT_MAX_TURNS=12
BOT_TOP_K=6
# full = every verified KB chunk in the live prompt (default)
# retrieval = top-K BM25 chunks only
BOT_CONTEXT=full

BOT_KB_DIR=../kb
BOT_DATA_DIR=data
BOT_OUT_DIR=out

# Postgres (Neon). When set, conversation state uses Postgres instead of SQLite.
# Vercel Marketplace Neon injects DATABASE_URL automatically.
DATABASE_URL=

# Local browser chat UI at http://127.0.0.1:8000/ (set 0 on deployed environments)
BOT_UI=1

# SalesIQ webhook. Leave the key blank for local /chat testing.
BOT_SALESIQ_PUBLIC_KEY=
BOT_ALLOW_UNVERIFIED=0
BOT_FORWARD_ON_HANDOFF=0
BOT_HANDOFF_OPERATOR=johnhenry.it@print247.us
